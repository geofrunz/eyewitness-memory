rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /responses/{studentUid} {
      // Replace INSTRUCTOR_UID with your Firebase instructor UID (same as config.js).
      function isInstructor() {
        return request.auth != null && request.auth.uid == 'INSTRUCTOR_UID';
      }
      allow get: if isInstructor() || (request.auth != null && request.auth.uid == studentUid);
      allow list: if isInstructor();
      allow create: if request.auth != null
        && request.auth.uid == studentUid
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasOnly(['group', 'speed', 'glass', 'submittedAt'])
        && request.resource.data.keys().hasAll(['group', 'speed', 'glass', 'submittedAt'])
        && request.resource.data.group in ['A', 'B']
        && request.resource.data.speed is number
        && request.resource.data.speed >= 0
        && request.resource.data.speed <= 500
        && request.resource.data.glass in ['Yes', 'No']
        && request.resource.data.submittedAt == request.time;
      allow update, delete: if false;
    }
  }
}
